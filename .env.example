# 仅在 init/run 时读取；roles/v0/demo/observe 不需要模型凭据。
# 使用支持 Chat Completions 和 JSON object 输出的兼容服务；不默认选择模型。
EVOTEAM_MODEL_ID=planning-model
EVOTEAM_MODEL_VERSION=deployment-1
EVOTEAM_MODEL_NAME=
EVOTEAM_MODEL_BASE_URL=
EVOTEAM_MODEL_API_KEY=
# 以下为运行配置示例，不是实验校准值；按所用服务与任务设置后再 init。
EVOTEAM_MODEL_TIMEOUT_SECONDS=60
EVOTEAM_MODEL_MAX_OUTPUT_TOKENS=2048
EVOTEAM_MODEL_TEMPERATURE=0
EVOTEAM_MODEL_TOP_P=1
