# DeepSeek 使用 OpenAI-compatible Chat Completions 和 JSON Object 输出。
# 复制为 .env 后只填写 API Key；不要提交真实 .env。
EVOTEAM_DATABASE_URL=sqlite:///evoteam.db
EVOTEAM_MODEL_ID=deepseek-v4-flash
EVOTEAM_MODEL_VERSION=api-2026-09
EVOTEAM_MODEL_NAME=deepseek-v4-flash
EVOTEAM_MODEL_BASE_URL=https://api.deepseek.com
EVOTEAM_MODEL_API_KEY=
# 以下为运行配置示例，不是实验校准值；按所用服务与任务设置后再 init。
EVOTEAM_MODEL_TIMEOUT_SECONDS=60
EVOTEAM_MODEL_MAX_OUTPUT_TOKENS=2048
EVOTEAM_MODEL_TEMPERATURE=0
EVOTEAM_MODEL_TOP_P=1
